{
  "name": "courier",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm --filter @courier/console run build",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:secrets": "node scripts/check-no-secrets.mjs",
    "gateway": "node packages/gateway/dist/bin/stdio.js",
    "mock": "node packages/mock-bitrefill/dist/bin/serve.js",
    "console": "pnpm --filter @courier/console start",
    "console:dev": "pnpm --filter @courier/console dev",
    "smoke": "node scripts/smoke-gateway.mjs"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@toon-format/toon": "^4.4.0",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "fast-check": "^4.10.2",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  }
}
