# --- Mode -------------------------------------------------------------
# demo: mock Bitrefill + simulated Zcash; needs no credentials (used by the live demo URL)
# live: real Bitrefill MCP + zipher-cli
COURIER_MODE=demo

# --- Bitrefill ----------------------------------------------------------
# From bitrefill.com/account/developers. Never commit.
BITREFILL_API_KEY=
BITREFILL_MCP_URL=https://api.bitrefill.com/mcp

# --- Handle store -------------------------------------------------------
# 32 random bytes, base64. Generate: openssl rand -base64 32
COURIER_VAULT_KEY=
COURIER_HANDLE_TTL_SECONDS=604800
COURIER_DATA_DIR=./data

# Demo mode only: share one mock between gateway and console (run `pnpm mock`).
# Leave empty to use an in-process mock.
MOCK_BITREFILL_URL=

# --- Purchasing ----------------------------------------------------------
# How Courier pays Bitrefill invoices. "balance" debits your Bitrefill account.
COURIER_PAYMENT_METHOD=balance
COURIER_BALANCE_CURRENCY=USD
# How often an in-flight invoice may be polled (Bitrefill suggests 10-30 s).
COURIER_POLL_INTERVAL_MS=10000

# --- Policy -------------------------------------------------------------
# Optional JSON policy file. Default: giftcards+esims, $10/order, $10/day,
# human approval above $2.
COURIER_POLICY_FILE=

# --- Console ------------------------------------------------------------
# Shared secret for the human approval console. Never exposed via MCP.
COURIER_CONSOLE_TOKEN=
# Hosted demo with no disk: keep orders and vault in memory.
COURIER_EPHEMERAL=

# --- Zcash (Zipher) -----------------------------------------------------
ZIPHER_CLI=./.vendor/zipher-app/rust/target/release/zipher-cli
ZIPHER_TESTNET=1
BUYER_ZCASH_UA=

# --- x402 / Base (Tier 3; demo custody, keep float <= $20) ---------------
RELAY_EVM_PRIVATE_KEY=
BASE_RPC_URL=https://mainnet.base.org
